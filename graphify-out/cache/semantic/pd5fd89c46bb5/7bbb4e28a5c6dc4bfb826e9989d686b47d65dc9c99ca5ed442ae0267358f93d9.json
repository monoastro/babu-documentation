or": null, "contributor": null}, {"id": "controller_old_readme_verificationreport", "label": "VerificationReport", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L44", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_schemapatch", "label": "SchemaPatch", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L46-L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_layoutpatch", "label": "LayoutPatch", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_repairplan", "label": "RepairPlan", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_datalab_ocr", "label": "Datalab OCR extraction", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L15, L57", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_extraction_schema", "label": "Extraction schema (JSON, per document type)", "file_type": "concept", "source_file": "controller-old/README.md", "source_location": "L46, L56", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "controller_old_readme_constrained_patches", "label": "Constrained patch vocabulary (design choice)", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L109-L112", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The LLM may only propose changes from a fixed vocabulary (add_field, modify_field, add_header_field, etc.) and cannot emit raw HTML, CSS, or Python. Trade-off: gives up expressiveness in exchange for a bounded, auditable, non-arbitrary-code-execution repair surface."}, {"id": "controller_old_readme_original_files_untouched", "label": "Original files untouched \u2014 patches write to _patched.json", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L112-L114", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schema patches are written to a sibling _patched.json rather than mutating the source schema, and the existing layout builder is reused as-is. Keeps every automated repair reversible and keeps the hand-authored builder as the single source of layout truth."}, {"id": "controller_old_readme_langgraph_interrupt", "label": "LangGraph interrupt() with MemorySaver checkpointer", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L114-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Human review is expressed as a LangGraph interrupt with a MemorySaver checkpointer so the identical graph can be driven from a CLI, a web API, or any other frontend without code changes \u2014 the frontend choice is deliberately kept out of the graph definition."}, {"id": "controller_old_readme_bounded_iterations", "label": "Bounded iterations (max_iterations)", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L117-L119", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "max_iterations (default 3) prevents infinite repair/edit loops; once the budget is spent only 'approve' remains available, forcing termination rather than unbounded LLM retry spend."}, {"id": "controller_old_readme_full_history", "label": "Append-only state history", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L36, L119-L121", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every iteration's verification result and human decision is appended to state[\"history\"] via LangGraph's add reducer, chosen so the loop is fully traceable after the fact instead of only exposing final state."}, {"id": "controller_old_readme_contenteditable_output", "label": "Contenteditable HTML output with data-field attributes", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L92-L105", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rendered HTML carries contenteditable=\"true\" plus data-field=\"field_name\" on every extracted value element (e.g. owner_name, plots.0.plot_no), with dashed-blue hover and solid outline + yellow focus affordances. Chosen so a plain browser is a usable correction UI with no app shell, and so edits map unambiguously back onto extraction-schema field paths."}, {"id": "controller_old_readme_visual_editor", "label": "Planned visual editor", "file_type": "rationale", "source_file": "controller-old/README.md", "source_location": "L122-L131", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Future work \u2014 drag-and-drop field reordering, resize handles, add/remove fields, live text sync back to the extraction schema. Deliberately routed through the same apply_edits graph node so the visual editor adds no second write path into the schema."}], "edges": [{"source": "controller_old_readme", "target": "controller_old_readme_graph_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "controller-old/README.md", "source_location": "L42", "weight": 1.0}, {"source": "controller_old_readme", "target": "controller_old_readme_run_py", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "controller-old/README.md", "source_location": "L43", "weight": 1.0}, {"source": "controller_old_readme", "target":